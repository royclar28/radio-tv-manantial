---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Radio TV Manantial 90.7 FM | La Fuente de tu Esperanza",
  description = "Radio TV Manantial 90.7 FM - Ríos de agua viva para salvación. Transmisión de alabanza, palabra y esperanza las 24 horas desde Venezuela para el mundo."
} = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{title}</title>
    
    <!-- Meta SEO & Social Sharing -->
    <meta name="description" content={description}>
    <meta name="theme-color" content="#070d1e">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">

    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-celestial-950 text-slate-100 font-sans antialiased selection:bg-amber-500 selection:text-slate-950 flex flex-col min-h-screen">

    <!-- REPRODUCTOR DE AUDIO HTML5 OCULTO -->
    <audio id="radioAudioStream" preload="none">
        <source src="https://radio.conectarservidor.com:8014/stream" type="audio/mpeg">
        Tu navegador no soporta el reproductor de audio en vivo.
    </audio>

    <!-- TOAST CONTAINER -->
    <div id="toastContainer" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-3"></div>

    <slot />

    <!-- MOTOR MODULAR DEL STREAMING Y SINCRONIZACIÓN SUPABASE -->
    <script src="../scripts/radioEngine.js"></script>
</body>
</html>
