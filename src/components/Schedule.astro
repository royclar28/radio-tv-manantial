---
// Schedule.astro
---
<section id="programacion" class="py-14 px-4 bg-celestial-900 border-t border-b border-white/5 relative">
    <div class="max-w-6xl mx-auto">
        
        <div class="flex flex-wrap items-end justify-between mb-8 gap-4">
            <div>
                <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-check"></i> Parrilla Oficial
                </span>
                <h2 class="font-display font-black text-2xl sm:text-3xl text-white mt-1">
                    Horarios y Programación de la Radio
                </h2>
                <p class="text-xs sm:text-sm text-slate-400 mt-1">Conoce nuestros horarios de transmisión y programas especiales en vivo.</p>
            </div>

            <!-- Selector de Día Activo -->
            <div class="flex items-center gap-1.5 bg-celestial-950 p-1 rounded-2xl border border-white/10 text-xs font-bold overflow-x-auto">
                <button type="button" onclick="window.filterScheduleDay('all')" id="sched-day-all" class="px-3 py-1.5 rounded-xl transition sched-day-btn bg-amber-500 text-slate-950 font-black cursor-pointer">Toda la Semana</button>
                <button type="button" onclick="window.filterScheduleDay('sabado')" id="sched-day-sabado" class="px-3 py-1.5 rounded-xl transition sched-day-btn text-slate-400 hover:text-white cursor-pointer">Sábados (En Vivo)</button>
                <button type="button" onclick="window.filterScheduleDay('semana')" id="sched-day-semana" class="px-3 py-1.5 rounded-xl transition sched-day-btn text-slate-400 hover:text-white cursor-pointer">Lunes a Viernes</button>
                <button type="button" onclick="window.filterScheduleDay('domingo')" id="sched-day-domingo" class="px-3 py-1.5 rounded-xl transition sched-day-btn text-slate-400 hover:text-white cursor-pointer">Domingos</button>
            </div>
        </div>

        <!-- TARJETA DESTACADA: PROGRAMA CENTRAL EN VIVO DE LOS SÁBADOS -->
        <div class="bg-gradient-to-r from-amber-500/15 via-celestial-850 to-celestial-850 border-2 border-amber-500/40 rounded-3xl p-6 sm:p-8 mb-8 shadow-xl relative overflow-hidden">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="space-y-2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500 text-slate-950">
                        <i class="fa-solid fa-microphone-lines"></i> Programa Central en Vivo
                    </div>
                    <h3 class="font-display font-black text-xl sm:text-2xl text-white">
                        Radio TV Manantial 90.7 FM - Enlace Especial en Directo
                    </h3>
                    <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
                        Transmisión estelar desde la cabina con oraciones, mensajes de fe, testimonios y participación abierta de los oyentes vía telefónica y WhatsApp.
                    </p>
                    <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-300 pt-2">
                        <span class="flex items-center gap-1.5 text-amber-300"><i class="fa-regular fa-clock"></i> <strong>Sábados:</strong> 5:00 PM – 6:00 PM</span>
                        <span class="flex items-center gap-1.5"><i class="fa-solid fa-tower-broadcast text-sky-400"></i> Dial 90.7 FM & Streaming Online</span>
                    </div>
                </div>
                <div class="shrink-0 flex items-center gap-3">
                    <a href="https://wa.me/584226690007?text=Quiero%20enviar%20mi%20peticion%20al%20programa%20del%20sabado" target="_blank" class="px-5 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-black shadow transition flex items-center gap-2 touch-manipulation">
                        <i class="fa-brands fa-whatsapp text-base"></i> Participar por WhatsApp
                    </a>
                </div>
            </div>
        </div>

        <!-- GRILLA DE PROGRAMAS HABITUALES -->
        <div id="scheduleGrid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Tarjeta 1: Lunes a Viernes -->
            <div class="sched-card semana bg-celestial-950 border border-white/10 rounded-2xl p-5 flex flex-col justify-between space-y-3">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-400 border border-sky-500/30">
                        Lunes a Viernes
                    </span>
                    <h4 class="font-black text-base text-white mt-2">Alabanzas & Mensajes de Fe</h4>
                    <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                        Música de adoración cristiana continua, salmos y reflexiones que llenan tu hogar de paz durante todo el día.
                    </p>
                </div>
                <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs text-amber-400 font-bold">
                    <span><i class="fa-regular fa-clock mr-1"></i> 24 Horas al Día</span>
                    <span class="text-slate-500 font-normal">Automatizado HD</span>
                </div>
            </div>

            <!-- Tarjeta 2: Sábados -->
            <div class="sched-card sabado bg-celestial-950 border border-amber-500/30 rounded-2xl p-5 flex flex-col justify-between space-y-3">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        Sábados • 5:00 PM
                    </span>
                    <h4 class="font-black text-base text-white mt-2">Transmisión Central en Cabina</h4>
                    <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                        Espacio exclusivo de edificación con música seleccionada, peticiones de oración en vivo y saludos a las comunidades.
                    </p>
                </div>
                <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs text-amber-400 font-bold">
                    <span><i class="fa-regular fa-clock mr-1"></i> 5:00 PM – 6:00 PM</span>
                    <span class="text-emerald-400 font-bold">En Vivo 🎙️</span>
                </div>
            </div>

            <!-- Tarjeta 3: Domingos -->
            <div class="sched-card domingo bg-celestial-950 border border-white/10 rounded-2xl p-5 flex flex-col justify-between space-y-3">
                <div>
                    <span class="text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">
                        Domingos de Gozo
                    </span>
                    <h4 class="font-black text-base text-white mt-2">Adoración y Familia</h4>
                    <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                        Programación especial dedicada al fortalecimiento espiritual del hogar, alabanzas de júbilo y mensajes de edificación.
                    </p>
                </div>
                <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs text-amber-400 font-bold">
                    <span><i class="fa-regular fa-clock mr-1"></i> Todo el Domingo</span>
                    <span class="text-slate-500 font-normal">En Familia</span>
                </div>
            </div>
        </div>

    </div>
</section>
