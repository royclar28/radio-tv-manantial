---
// TopMarquee.astro
---
<div class="bg-gradient-to-r from-celestial-900 via-indigo-950 to-celestial-900 border-b border-white/10 text-xs py-1.5 px-4 text-slate-300">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-400 border border-rose-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span> AL AIRE
            </span>
            <span id="headerMarqueeText" class="text-[11px] font-medium text-slate-200 truncate">
                "Ríos de agua viva para salvación" • Sintonízanos en el dial 90.7 FM y señal online 24/7
            </span>
        </div>
        <div class="flex items-center gap-3 text-xs">
            <a href="https://wa.me/584226690007?text=Hola%20Radio%20TV%20Manantial%2090.7%20FM,%20les%20escribo%20desde%20la%20página%20web" target="_blank" class="text-emerald-400 hover:text-emerald-300 font-bold flex items-center gap-1 transition">
                <i class="fa-brands fa-whatsapp text-sm"></i> <span class="hidden sm:inline">WhatsApp Cabina</span>
            </a>
            <button type="button" onclick="window.openAdminModal()" class="text-slate-400 hover:text-amber-400 text-xs transition cursor-pointer" title="Acceso al Panel de Control del Director">
                <i class="fa-solid fa-lock text-[11px]"></i> <span class="hidden md:inline">Director</span>
            </button>
        </div>
    </div>
</div>
